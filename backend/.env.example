# FastAPI Config
APP_NAME="Quantum PharmX Backend"
DEBUG=True

# Security
# Run `openssl rand -hex 32` to generate a secure secret key
JWT_SECRET_KEY="replace_this_with_a_secure_random_key_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Use local connection for host dev or 'db' for docker compose
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmx_db"

# Celery & Redis Configuration
# Use local connection for host dev or 'redis' for docker compose
REDIS_URL="redis://localhost:6379/0"

# Directories
UPLOAD_DIR="uploads"
OUTPUT_DIR="outputs"

# Limits
MAX_UPLOAD_SIZE=20971520 # 20MB in bytes

# Computational Executable Paths (overrides if binaries located elsewhere)
VINA_EXECUTABLE="vina"
OBABEL_EXECUTABLE="obabel"
